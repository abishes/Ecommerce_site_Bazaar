@model Bazaar.Models.DbModels.Product

@* <img src="~/images/@Model.ImageFileName" class="w-100" />
<br>
<h1>Price @Model.Price</h1>
<a asp-controller="Home" asp-action="Index">Go Back</a> *@


<div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/@Model.ImageFileName" class="img-fluid product-image">
            </div>
            <div class="col-md-6">
                <h1 class="product-title">@Model.Name</h1>
                <p><strong>Category: @Model.Category</strong></p>
                <p class="product-description">@Model.Description</p>
                <p>Product enlist date:@Model.Date</p>
                <p class="product-price">Rs.@Model.Price</p>
                <div class="d-flex flex-column mt-4">
                        <a asp-controller="Product" asp-action="BuyProduct" asp-route-id="@Model.Id" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-sm" type="button">Buy Now</a>
                </div>
            </div>
        </div>
    </div>