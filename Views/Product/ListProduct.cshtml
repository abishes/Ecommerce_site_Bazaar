@model List<Bazaar.Models.DbModels.Product>
<h1>All The Products For sell</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var product in Model){
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>
                    <a class="btn btn-primary" asp-controller="product" asp-action="EditProduct" asp-route-id="@product.Id">Edit</a>
                    <form method="post" asp-controller="product" asp-action="DeleteProduct">
                        <input type="text" name="Id" id="Id" value="@product.Id" style="display: none;">
                                    <button type="submit" class="btn btn-primary">Delete</button>
                    </form>
                    @* <a class="btn btn-danger" asp-controller="product" asp-action="DeleteProduct" asp-route-id="@product.Id">Delete</a> *@
                </td>
            </tr>
        }
    </tbody>
</table>
<br>
<a class="btn btn-primary" asp-controller="Product" asp-action="AddProduct">+</a>
